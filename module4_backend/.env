# Copy this file to .env and adjust values for your environment.

# Redis
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_CHANNEL=kiosk:queue:events

# Security module URL (use mock for local dev)
SECURITY_SERVICE_URL=http://localhost:8001

# FSM thresholds — ratify with Voice AI and Biometrics owners before changing
CONFIDENCE_THRESHOLD=0.7
MAX_AUTH_RETRIES=2

# Token expiry fallback (minutes) used if Security doesn't specify expires_at
TOKEN_EXPIRY_MINUTES=10
