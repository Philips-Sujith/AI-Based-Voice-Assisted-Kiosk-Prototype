# Public HTTPS URL for camera pages (ngrok tunnel on a real phone)
FACE_AUTH_BASE_URL=https://your-public-https-url.example

# Cosine similarity threshold for 1:N ArcFace match (default 0.6)
FACE_MATCH_THRESHOLD=0.6

# Liveness (blink) window
LIVENESS_MIN_FRAMES=12
LIVENESS_WINDOW_SECONDS=2.5
LIVENESS_EAR_CLOSED_RATIO=0.72
LIVENESS_EAR_REOPEN_RATIO=0.85

# MiniFASNet real-class minimum after softmax fusion
ANTISPOOF_MIN_REAL_SCORE=0.70

# SQLite location
SQLITE_PATH=./data/face_auth.db
